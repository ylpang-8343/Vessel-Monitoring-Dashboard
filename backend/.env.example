DATABASE_URL=postgresql+psycopg://vessel:vessel@localhost:5432/vessel_monitoring
ANTHROPIC_API_KEY=
TRACKING_POLL_INTERVAL_SECONDS=300
ARRIVED_RETENTION_DAYS=10
CORS_ORIGINS=["http://localhost:3000"]

# Sign session cookies - anyone with this value can forge a login, so it MUST be overridden
# with a long random string for anything beyond local dev (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_EXPIRE_DAYS=7
# Set to true once served over https - browsers drop Secure cookies over plain http.
COOKIE_SECURE=false
